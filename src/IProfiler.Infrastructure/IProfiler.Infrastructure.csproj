<Project Sdk="Microsoft.NET.Sdk">
  <!-- One provider class per Core interface, one folder per provider. The ONLY project allowed
       to reference third-party imaging/scan/OCR/PDF libraries (enforced by IProfiler.Tests).
       Logs through ILogger<T>; Serilog is configured only in IProfiler.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IProfiler.Core\IProfiler.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Sdcb.PaddleOCR" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" />
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="ZXing.Net.Bindings.OpenCV.V4" />
    <PackageReference Include="PDFsharp" />
    <PackageReference Include="BitMiracle.LibTiff.NET" />
  </ItemGroup>
  <ItemGroup>
    <!-- OCR models ship with the app (offline, no runtime download). They flow to every project that
         references Infrastructure and land in <output>\models\, which is AppPaths.Models. -->
    <None Include="..\..\models\ppocrv5-mobile\**\*" LinkBase="models\ppocrv5-mobile" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
