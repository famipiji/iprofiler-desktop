<Project>
  <!-- Central package management: every package version is pinned here, nowhere else. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Hosting and logging">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <!-- Design-time only (dotnet ef migrations); PrivateAssets, never shipped. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="OCR, barcode and imaging (IProfiler.Infrastructure only)">
    <PackageVersion Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageVersion Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
    <!-- Sdcb.PaddleOCR 3.3.1 is built against OpenCvSharp4 4.11.0.20250507; keep the managed and native packages on that version. -->
    <PackageVersion Include="OpenCvSharp4" Version="4.11.0.20250507" />
    <PackageVersion Include="OpenCvSharp4.runtime.win" Version="4.11.0.20250507" />
    <!-- 0.16.11 is the last OpenCV binding built against OpenCvSharp4 4.11 (0.16.12+ needs 4.13). -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
    <PackageVersion Include="ZXing.Net.Bindings.OpenCV.V4" Version="0.16.11" />
    <!-- PDF (MIT) and multi-page TIFF (BSD). PDFsharp for the spike sidesteps the QuestPDF licence question.
         6.2.4 is the LAST MIT release: 6.5.0 (Oct 2026) is AGPL-3.0 with a licence-key check. Don't upgrade
         (a test enforces this); see docs/risk-register.md. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <!-- Transitive pin: PDFsharp 6.5.0 asks for 8.0.1, which has known advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
