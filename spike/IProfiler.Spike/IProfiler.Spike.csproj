<Project Sdk="Microsoft.NET.Sdk">
  <!-- Milestone 1 throwaway console: drives the real Infrastructure providers against sample files.
       Same rule as the App: no third-party imaging/OCR types here, only Core interfaces. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Same framework files as the WPF app, so the Task 1.6 spike installer can put both exes in one folder
         (otherwise WindowsBase.dll and System.Security.Cryptography.Pkcs.dll differ). Still a console app. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWPF drops System.IO from the implicit usings. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\IProfiler.Core\IProfiler.Core.csproj" />
    <ProjectReference Include="..\..\src\IProfiler.Application\IProfiler.Application.csproj" />
    <ProjectReference Include="..\..\src\IProfiler.Data\IProfiler.Data.csproj" />
    <ProjectReference Include="..\..\src\IProfiler.Infrastructure\IProfiler.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
</Project>
